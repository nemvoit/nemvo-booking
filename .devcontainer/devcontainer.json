{
	"name": "Nemvo Booking (WordPress)",
	"dockerComposeFile": "docker-compose.yml",
	"service": "wordpress",
	"runServices": ["db", "wordpress", "mailpit", "cap", "valkey"],
	"workspaceFolder": "/workspace",
	"shutdownAction": "stopCompose",
	"forwardPorts": [8080, 8025, 3000],
	"portsAttributes": {
		"8080": { "label": "WordPress" },
		"8025": { "label": "Mailpit" },
		"3000": { "label": "Cap" }
	},
	"postStartCommand": "bash /workspace/.devcontainer/setup.sh",
	"customizations": {
		"vscode": {
			"extensions": ["bmewburn.vscode-intelephense-client", "xdebug.php-debug"]
		}
	}
}
